rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /community/{uid}/{file} {
   allow read: if request.auth != null;
   allow create: if request.auth != null && request.auth.uid == uid
     && ((request.resource.contentType.matches('image/(jpeg|png|webp|gif)') && request.resource.size <= 10 * 1024 * 1024)
     || (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size <= 50 * 1024 * 1024));
   allow delete: if request.auth != null && (request.auth.uid == uid || (request.auth.token.email == 'losermodder@gmail.com' && request.auth.token.email_verified == true));
   allow update: if false;
  }

  // Avatar do próprio usuário. O URL de download é salvo no perfil após upload.
  match /avatars/{uid}/{file} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null && request.auth.uid == uid
     && file == 'profile'
     && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
     && request.resource.size <= 5 * 1024 * 1024;
   allow delete: if request.auth != null && (request.auth.uid == uid || (request.auth.token.email == 'losermodder@gmail.com' && request.auth.token.email_verified == true));
  }

  // Foto do Tinder usada pelo mesmo perfil no site e na Charlotte.
  match /tinder/{uid}/{file} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null && request.auth.uid == uid
     && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
     && request.resource.size <= 10 * 1024 * 1024;
   allow delete: if request.auth != null && (request.auth.uid == uid || (request.auth.token.email == 'losermodder@gmail.com' && request.auth.token.email_verified == true));
  }
 }
}
