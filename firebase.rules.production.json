{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','nome','createdAt']) && newData.child('uid').val() === auth.uid && newData.child('nome').isString() && newData.child('nome').val().length <= 40 && (!newData.child('bio').exists() || (newData.child('bio').isString() && newData.child('bio').val().length <= 180)) && (!newData.child('favoriteAnime').exists() || (newData.child('favoriteAnime').isString() && newData.child('favoriteAnime').val().length <= 80))"
      }
    },
    "directory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','nome']) && newData.child('uid').val() === auth.uid && newData.child('nome').isString() && newData.child('nome').val().length <= 40"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && ((!newData.exists() && (auth.uid === $uid || auth.uid === $friendUid)) || (newData.exists() && auth.uid === $uid && root.child('friendRequests').child($uid).child($friendUid).exists()) || (newData.exists() && auth.uid === $friendUid && root.child('friendRequests').child($friendUid).child($uid).exists()))"
        }
      }
    },
    "friendRequests": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$senderUid": {
          ".write": "auth != null && ((auth.uid === $senderUid && newData.exists() && newData.child('senderUid').val() === auth.uid) || (auth.uid === $targetUid && !newData.exists()))"
        }
      }
    },
    "pokemonWeb": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "charlotteLinkRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','code','createdAt','expiresAt']) && newData.child('uid').val() === auth.uid && newData.child('code').isString() && newData.child('code').val().length === 6"
      },
      ".indexOn": [
        "code"
      ]
    },
    "charlottePublic": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "charlotteSync": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "siteBridgeJobs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$jobId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.child('type').isString() && (newData.child('type').val() === 'sync_pokemon' || newData.child('type').val() === 'sync_account' || newData.child('type').val() === 'daily_claim' || newData.child('type').val() === 'buy_customization' || newData.child('type').val() === 'equip_customization' || newData.child('type').val() === 'premium_checkout' || newData.child('type').val() === 'send_download_link' || newData.child('type').val() === 'duel_challenge' || newData.child('type').val() === 'duel_accept' || newData.child('type').val() === 'duel_decline' || newData.child('type').val() === 'duel_move'))"
        }
      }
    },
    "pokemonSiteChallenges": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "pokemonSiteDuelIndex": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "pokemonSiteDuels": {
      "$duelId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": false
      }
    },
    "rpgUserRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rpgRooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta').child('ownerUid').val() === auth.uid && newData.child('members').child(auth.uid).child('uid').val() === auth.uid) || (data.exists() && data.child('meta').child('ownerUid').val() === auth.uid))",
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rpgRooms').child($code).child('meta').child('ownerUid').val() === auth.uid)"
          }
        },
        "characters": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rpgRooms').child($code).child('meta').child('ownerUid').val() === auth.uid)"
          }
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && root.child('rpgRooms').child($code).child('members').child(auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid)"
          }
        },
        "rolls": {
          "$rollId": {
            ".write": "auth != null && root.child('rpgRooms').child($code).child('members').child(auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid)"
          }
        },
        "initiative": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rpgRooms').child($code).child('meta').child('ownerUid').val() === auth.uid)"
          }
        }
      }
    },
    "charlottePrivate": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "whatsappJid"
      ]
    },
    "siteBridgeResults": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "siteInventory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "siteCustomization": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rpgVoice": {
      "$code": {
        ".read": "auth != null && root.child('rpgRooms').child($code).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('rpgRooms').child($code).child('members').child(auth.uid).exists()"
        }
      }
    },
    "rpgRtc": {
      "$code": {
        "$targetUid": {
          ".read": "auth != null && auth.uid === $targetUid && root.child('rpgRooms').child($code).child('members').child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && ((newData.exists() && newData.child('fromUid').val() === auth.uid && root.child('rpgRooms').child($code).child('members').child(auth.uid).exists() && root.child('rpgRooms').child($code).child('members').child($targetUid).exists()) || (!newData.exists() && auth.uid === $targetUid))"
          }
        }
      }
    }
  }
}